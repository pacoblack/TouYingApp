<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="vm"
            type="com.find.gang.file.viewmodel.TransferViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#181818"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 顶部网址导航栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBrowserBack"
                android:layout_width="86dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_tv_focus_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/webView"
                android:nextFocusRight="@id/btnBrowserRefresh"
                android:text="后退"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBrowserRefresh"
                android:layout_width="86dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_tv_focus_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/webView"
                android:nextFocusLeft="@id/btnBrowserBack"
                android:nextFocusRight="@id/etBrowserUrl"
                android:text="刷新"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 默认焦点控件：对应 getDefaultFocusViewId() -->
            <EditText
                android:id="@+id/etBrowserUrl"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_focus_btn"
                android:focusable="true"
                android:gravity="center_vertical"
                android:hint="输入网址，或用手机快传推送链接自动打开..."
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:nextFocusDown="@id/webView"
                android:nextFocusLeft="@id/btnBrowserRefresh"
                android:nextFocusRight="@id/btnBrowserGo"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnBrowserGo"
                android:layout_width="110dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_tv_focus_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/webView"
                android:nextFocusLeft="@id/etBrowserUrl"
                android:text="访问"
                android:textColor="#4FC3F7"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 网页内容容器：向下按遥控器直接落入底部导航栏 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="#121212">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:nextFocusDown="@id/tabBrowser"
                android:nextFocusUp="@id/etBrowserUrl" />

            <ProgressBar
                android:id="@+id/pbBrowserLoading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:progressTint="#4FC3F7"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</layout>
