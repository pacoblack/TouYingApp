<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="vm"
            type="com.find.gang.file.viewmodel.TransferViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#181818"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 顶部标题 & 视频直链快捷输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:text="在线视频 &amp; 直链投屏"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etVideoStreamUrl"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_focus_btn"
                android:focusable="true"
                android:gravity="center_vertical"
                android:hint="输入或通过手机快传推送 m3u8 / mp4 视频链接..."
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:nextFocusDown="@id/rvVideoList"
                android:nextFocusRight="@id/btnPlayStream"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnPlayStream"
                android:layout_width="130dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_tv_focus_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/rvVideoList"
                android:nextFocusLeft="@id/etVideoStreamUrl"
                android:text="▶ 立即播放"
                android:textColor="#4FC3F7"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 视频推荐 / 历史网格列表：默认焦点控件，对应 getDefaultFocusViewId() -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVideoList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:nextFocusDown="@id/tabVideo"
            android:nextFocusUp="@id/etVideoStreamUrl"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="4"
            tools:itemCount="8" />
    </LinearLayout>
</layout>
